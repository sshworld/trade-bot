# Binance (API key: trading only, withdrawals OFF, IP-whitelisted to the server)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Strategy (live trading supports only live_v1 = A-fixed 4h Turtle; legacy strategy C disabled)
STRATEGY=live_v1
LIVE_V1_SYMBOL=BTCUSDT
LIVE_V1_DIRECTION=both
# Optional external heartbeat (e.g. https://hc-ping.com/<uuid>); pinged every 60s while healthy
HEALTHCHECK_PING_URL=

# Fault-injection tests against Binance Futures TESTNET only (pytest -m testnet)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Alert (optional)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
